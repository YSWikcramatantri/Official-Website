{
  "version": 2,
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node@3.0.19" },
    { "src": "client/package.json", "use": "@vercel/static-build@2.0.0" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/((?!api|.*\\..*).*)", "dest": "/index.html" }
  ],
  "outputDirectory": "dist/public"
}